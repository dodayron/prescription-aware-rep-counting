+    # ------------------------------------------------------------------
+    # Auto-calibration: learn this user's rest and peak angles from the first
+    # `calib_cycles` repetitions, then set thresholds with a ROM margin.
+    # ------------------------------------------------------------------
+    def reset_calibration(self):
+        self.rest_thresh, self.peak_thresh = self.default_rest, self.default_peak
+        self.mode = "calibrating" if self.calibration_enabled else "counting"
+        self._calib_buf = []
+        self.calib_depth = self.calib_stand = None
+        self.calib_clamped = False
+
+    def _calibration_step(self, angle):
+        """Returns True when calibration has just completed."""
+        self._calib_buf.append(np.nan if angle is None else float(angle))
+        if len(self._calib_buf) > self.calib_max_frames:
+            # could not find enough cycles: fall back to the fixed thresholds
+            self.mode = "counting"
+            return False
+        buf = np.array(self._calib_buf, dtype=float)
+        good = ~np.isnan(buf)
+        if good.sum() < 2 * self.calib_distance:
+            return False
+        idx = np.arange(len(buf))
+        buf = np.interp(idx, idx[good], buf[good])     # fill dropped frames
+        f = _median_filter(buf, 5)
+        sig = f if self.direction == "decrease" else -f  # minima of sig = exercise peaks
+        mins = _find_minima(sig, self.calib_prominence, self.calib_distance)
+        if len(mins) < self.calib_cycles:
+            return False
+        # wait until the user has come back up after the last calibration rep:
+        # the latest value must be within the margin of the standing level
+        stand_sig = np.percentile(sig[: mins[self.calib_cycles - 1] + 1], 90)
+        depth_sig = float(np.mean(sig[mins[: self.calib_cycles]]))
+        rom = stand_sig - depth_sig
+        if rom <= 0 or sig[-1] < stand_sig - self.calib_margin * rom:
+            return False
+        if self.direction == "decrease":
+            depth, stand = depth_sig, stand_sig
+        else:
+            depth, stand = -depth_sig, -stand_sig
+        self._apply_calibration(depth, stand)
+        return True
