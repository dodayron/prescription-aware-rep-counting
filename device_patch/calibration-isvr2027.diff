+# ---------------------------------------------------------------------------
+# Auto-calibration helpers (pure numpy so nothing new is needed on the Pi)
+# ---------------------------------------------------------------------------
+def _median_filter(x, k=5):
+    """Odd-window running median with edge padding (same output length as x)."""
+    x = np.asarray(x, dtype=float)
+    if len(x) < k:
+        return x.copy()
+    h = k // 2
+    xp = np.pad(x, (h, h), mode="edge")
+    return np.array([np.median(xp[i:i + k]) for i in range(len(x))])
+
+
+def _find_minima(x, prominence=15.0, distance=15):
+    """Indices of local minima of x whose prominence (rise on BOTH sides) is >= `prominence`
+    and that are at least `distance` samples apart. Same idea as scipy.signal.find_peaks(-x)."""
+    x = np.asarray(x, dtype=float)
+    n = len(x)
+    cand = [i for i in range(1, n - 1) if x[i] <= x[i - 1] and x[i] < x[i + 1]]
+    keep = []
+    for i in cand:
+        # prominence = min rise to the highest point on either side before a lower minimum
+        lo_left = x[i]
+        j = i - 1
+        lmax = x[i]
+        while j >= 0 and x[j] >= lo_left:
+            lmax = max(lmax, x[j]); j -= 1
+        j = i + 1
+        rmax = x[i]
+        while j < n and x[j] >= lo_left:
+            rmax = max(rmax, x[j]); j += 1
+        prom = min(lmax, rmax) - x[i]
+        if prom >= prominence:
+            keep.append((i, prom))
+    # enforce minimum distance, keeping the more prominent minimum
+    keep.sort(key=lambda t: -t[1])
+    chosen = []
+    for i, p in keep:
+        if all(abs(i - c) >= distance for c in chosen):
+            chosen.append(i)
+    return sorted(chosen)
+
