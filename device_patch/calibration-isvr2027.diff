@@ -0,0 +1,69 @@
+"""Per-frame CSV logger for bench tests (goniometer, lux sweep, latency).
+
+Usage:
+    logger = FrameLogger("logs/session.csv")      # None -> logging disabled
+    logger.log(exercise, angle, fps)               # once per processed frame
+    logger.close()
+
+Columns: timestamp (ISO, ms), t_rel_s, frame, exercise, mode, angle, angle_left, angle_right,
+         state, reps, mean_visibility, band_status, rest_thresh, peak_thresh, fps
+"""
+import csv
+import os
+import time
+from datetime import datetime
+
+
+class FrameLogger:
+    FIELDS = ["timestamp", "t_rel_s", "frame", "exercise", "mode", "angle", "angle_left", "angle_right",
+              "state", "reps", "mean_visibility", "band_status", "rest_thresh", "peak_thresh", "fps"]
+
+    def __init__(self, path=None):
+        self.path = path
+        self._f = None
+        self._w = None
+        self._n = 0
+        self._t0 = time.time()
+        if path:
+            d = os.path.dirname(path)
+            if d:
+                os.makedirs(d, exist_ok=True)
+            self._f = open(path, "w", newline="")
+            self._w = csv.DictWriter(self._f, fieldnames=self.FIELDS)
+            self._w.writeheader()
+
+    @property
+    def enabled(self):
+        return self._w is not None
+
+    def log(self, ex, angle, fps=None):
+        if not self._w:
+            return
+        self._n += 1
+        now = time.time()
+        sa = getattr(ex, "last_side_angles", {}) or {}
+        row = dict(
+            timestamp=datetime.now().isoformat(timespec="milliseconds"),
+            t_rel_s=f"{now - self._t0:.3f}",
+            frame=self._n,
+            exercise=ex.name,
+            mode=getattr(ex, "mode", "counting"),
+            angle="" if angle is None else f"{angle:.2f}",
+            angle_left="" if "left" not in sa else f"{sa['left']:.2f}",
+            angle_right="" if "right" not in sa else f"{sa['right']:.2f}",
+            state=ex.stage,
+            reps=ex.reps,
+            mean_visibility="" if getattr(ex, "last_mean_visibility", None) is None else f"{ex.last_mean_visibility:.3f}",
+            band_status=ex.band_status(angle) if hasattr(ex, "band_status") else "",
+            rest_thresh=f"{ex.rest_thresh:.1f}",
+            peak_thresh=f"{ex.peak_thresh:.1f}",
+            fps="" if fps is None else f"{fps:.1f}",
+        )
+        self._w.writerow(row)
+        if self._n % 50 == 0:
+            self._f.flush()
+
+    def close(self):
+        if self._f:
+            self._f.close()
+            self._f = self._w = None
